#include <winver.h>
#ifndef STELLARCOOP_VERSION
#define STELLARCOOP_VERSION "dev"
#endif

VS_VERSION_INFO VERSIONINFO
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Stellar Blade Online, a co-op mod for Stellar Blade"
            VALUE "FileVersion", STELLARCOOP_VERSION
            VALUE "LegalCopyright", "Copyright (C) 2026 MotherSphere and the Stellar Blade Online contributors. SBO License 1.0 or later."
            VALUE "ProductName", "Stellar Blade Online"
            VALUE "ProductVersion", STELLARCOOP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
